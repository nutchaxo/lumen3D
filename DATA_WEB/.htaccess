# Lumen3D — published dataset tree (lumen-guard v2). Generated by the
# platform (api/_upload_lib.php, upload_staging.py); keep the copy in the
# repository (DATA_WEB/.htaccess) identical.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php5.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|php[0-9]|phtml|phps|phar|cgi|pl|py|sh|shtml|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .phar .cgi .pl .py .sh .shtml
    RemoveType .php .phtml .phar
</IfModule>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    <IfModule mod_setenvif.c>
        SetEnvIf Request_URI "/download/" LUMEN_DOWNLOAD=1
        Header set Content-Disposition "attachment" env=LUMEN_DOWNLOAD
    </IfModule>
</IfModule>
