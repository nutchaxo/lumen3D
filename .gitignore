# Environments
.venv-312/
.env
__pycache__/
*.pyc

# Local Python runtime bootstrapped by the self-contained preprocess launcher
.runtime/

# Datasets / Large files
DATA_WEB/*
!DATA_WEB/.gitkeep
*.nii
*.nii.gz
*.ome.tif
*.tif
*.tiff
*.dzi
*.db

# Work in progress / Personal files
DOCS/*
!DOCS/plugins/
!DOCS/update-system/
!DOCS/plugin-sandbox/
!DOCS/admin-guide/
platform_data_inventory.xlsx
platform_preselection_fixed_live.xlsx
test_meta.html

# IDEs / assistant local state
.vscode/
.agents/
.idea/
.claude/settings.local.json

# Logs
logs/
*.log

# Signing seeds (marketplace / release private keys — machine-local, NEVER commit)
secrets/

# Admin runtime state (secret / machine-local — never commit)
api/config.json
api/admin_credential.json
api/stats.json
api/disabled-plugins.json
api/quarantined-plugins.json
api/plugin-trust.json
api/page-drafts/

# Self-update backups + runtime artifacts (version.json ships in the release
# artifact and is written by updates — never tracked in git)
backups/
version.json
dist/

# One-file installer runtime state (install.php) — never commit
.install-state.json
.install-lock
.install-download.zip.part

# Operator-uploaded media (runtime, per-deployment — not source)
config/uploads/

# Downloadable processing pack — BUILT by tools/build_pipeline_bundle.py (which the
# release build re-runs), never authored. Committing it would add a few MB of binary
# to history on every version bump; a deployed host gets it from the release zip.
assets/pipeline/
