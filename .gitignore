# Environments
.venv-312/
.env
__pycache__/
*.pyc

# Local Python runtime bootstrapped by the self-contained preprocess launcher
.runtime/

# Datasets / Large files
DATA_WEB/*
!DATA_WEB/.gitkeep
# The published tree IS web-served, so its execution ban must ship with the code
# (a dataset can also arrive by SFTP, bypassing the import allowlist entirely).
!DATA_WEB/.htaccess

# Dataset import staging — browser-supplied bytes awaiting validation. Never
# served (see _FORBIDDEN_ROOTS / root .htaccess / router.php), never committed.
uploads/
*.nii
*.nii.gz
*.ome.tif
*.tif
*.tiff
*.dzi
*.db

# Work in progress / Personal files
DOCS/*
!DOCS/plugins/
!DOCS/update-system/
!DOCS/plugin-sandbox/
!DOCS/admin-guide/
!DOCS/dataset-migrations/
# Published operator documents, served by the admin Documentation tab straight
# from GitHub. The filename is the metadata: "260803 - GUIDE-ADMIN - FR.pdf".
!DOCS/*.pdf
!DOCS/*.md
platform_data_inventory.xlsx
platform_preselection_fixed_live.xlsx
test_meta.html

# IDEs / assistant local state
.vscode/
.agents/
.idea/
.claude/settings.local.json

# Logs
logs/
*.log

# Signing seeds (marketplace / release private keys — machine-local, NEVER commit)
secrets/

# Admin runtime state (secret / machine-local — never commit)
api/config.json
api/admin_credential.json
api/stats.json
api/disabled-plugins.json
api/quarantined-plugins.json
api/plugin-trust.json
api/release-notes-cache.json
api/page-drafts/
api/trusted-proxies.json
# PHP runtime stores (sessions, login throttle, file locks, caches, update lock and
# the busy files a Windows update parks for the next request)
api/.sessions/
api/.bruteforce/
api/.locks/
api/.catalog-cache.json
api/.plugin-hash-cache.json
api/.update.lock
api/.update-pending.json
api/.tmp-*
# Sources an update parks beside the live ones, and the copy of the previous root
# .htaccess the PHP updater keeps
*.lumen-old
*.lumen-new
.htaccess.lumen-backup
.update-staging-*/
# Runtime probes / CA seed written by the PHP backend at the install root
.lumen-perm-probe
.lumen-ca-seed.pem

# Self-update backups + runtime artifacts (version.json ships in the release
# artifact and is written by updates — never tracked in git)
backups/
version.json
dist/

# One-file installer runtime state (install.php) — never commit
.install-state.json
.install-lock
.install-download.zip.part

# Operator-uploaded media (runtime, per-deployment — not source)
config/uploads/

# Downloadable processing pack — BUILT by tools/build_pipeline_bundle.py (which the
# release build re-runs), never authored. Committing it would add a few MB of binary
# to history on every version bump; a deployed host gets it from the release zip.
assets/pipeline/
